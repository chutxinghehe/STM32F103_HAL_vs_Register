--cpu Cortex-M3
"test_hal\startup_stm32f103xb.o"
"test_hal\main.o"
"test_hal\stm32f1xx_it.o"
"test_hal\stm32f1xx_hal_msp.o"
"test_hal\stm32f1xx_hal_gpio_ex.o"
"test_hal\stm32f1xx_hal.o"
"test_hal\stm32f1xx_hal_rcc.o"
"test_hal\stm32f1xx_hal_rcc_ex.o"
"test_hal\stm32f1xx_hal_gpio.o"
"test_hal\stm32f1xx_hal_dma.o"
"test_hal\stm32f1xx_hal_cortex.o"
